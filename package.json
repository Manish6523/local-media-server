{
  "name": "vidlock",
  "version": "0.1.23",
  "private": true,
  "author": {
    "name": "Manish",
    "email": "ms5392363@gmail.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build --webpack",
    "start": "set NODE_ENV=production&& tsx server.ts",
    "serve": "npm run build && npm run start",
    "lint": "eslint",
    "electron:dev": "npm rebuild better-sqlite3 && tsc -p tsconfig.electron.json && concurrently --kill-others \"npm run dev\" \"wait-on http://localhost:2886 && electron .\"",
    "electron:build": "npm run build && tsc -p tsconfig.electron.json && electron-builder",
    "electron:build:linux": "npm run electron:build -- --linux",
    "electron:build:win": "npm run electron:build -- --win",
    "electron:build:mac": "npm run electron:build -- --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fanart-tv/api": "^1.0.2",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.40.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.17.0",
    "next": "16.2.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.10.0",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "ffmpeg-static@5.3.0": true,
    "ffprobe-static@3.1.0": true
  }
}
